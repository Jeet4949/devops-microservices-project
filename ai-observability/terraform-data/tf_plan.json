{
  "format_version": "1.1",
  "resource_changes": [
    {
      "address": "aws_db_instance.prod_database",
      "mode": "managed",
      "type": "aws_db_instance",
      "change": {
        "actions": ["delete"],
        "before": {"identifier": "prod-db-main", "engine": "postgres"}
      }
    },
    {
      "address": "aws_db_instance.dev_database",
      "mode": "managed",
      "type": "aws_db_instance",
      "change": {
        "actions": ["create"],
        "after": {
          "identifier": "dev-db-new",
          "engine": "postgres",
          "password": "SuperSecretPassword123!",
          "username": "admin"
        }
      }
    },
    {
      "address": "aws_security_group.web_sg",
      "mode": "managed",
      "type": "aws_security_group",
      "change": {
        "actions": ["update"],
        "after": {
          "ingress": [
            {"from_port": 22, "to_port": 22, "protocol": "tcp", "cidr_blocks": ["0.0.0.0/0"]}
          ]
        }
      }
    }
  ]
}
